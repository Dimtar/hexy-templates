{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS neoguard 1.0.0"
  },
  "installation_questions": [
    {
      "question": "Auth user",
      "type": "text",
      "key": "auth_user",
      "required": true
    },
    {
      "question": "Auth pass",
      "type": "password",
      "key": "auth_pass",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30600]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/neoguard"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/neoguard/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    }
  ],
  "app_values": {
    "neoguard": {
      "auth_user": "$QUESTION(auth_user)",
      "auth_pass": "$QUESTION(auth_pass)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/neoguard/data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30600}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
