{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS briefkasten 1.6.27"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30080]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/briefkasten"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/briefkasten/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "briefkasten": {
      "nextauth_secret": "$RANDOM_STRING(32)",
      "postgres_password": "$RANDOM_STRING(16)",
      "nextauth_url": "http://$SERVER_LAN_IP:30080"
    },
    "storage": {
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/briefkasten/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30080}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
