{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS zabbix 1.0.38"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30385, 30386]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/zabbix"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/zabbix/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "zabbix": {"db_password": "$RANDOM_STRING(16)"},
    "storage": {
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/zabbix/postgres_data)"
    },
    "network": {
      "server_port": {"bind_mode": "published", "port_number": 30385},
      "web_port": {"bind_mode": "published", "port_number": 30386}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
