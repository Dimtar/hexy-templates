{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS zwave-js-ui 1.1.30"
  },
  "installation_questions": [
    {
      "question": "Serial port",
      "type": "text",
      "key": "serial_port",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30191]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/zwave-js-ui"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/zwave-js-ui/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    }
  ],
  "app_values": {
    "zwave": {
      "session_secret": "$RANDOM_STRING(32)",
      "serial_port": "$QUESTION(serial_port)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/zwave-js-ui/data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30191}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
