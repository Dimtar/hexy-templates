    }
  ],
  "app_values": {
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/metatana/data)",
      "media": "$HOST_PATH($LOCATION(Media))"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30457}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
