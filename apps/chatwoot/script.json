{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS chatwoot 1.2.54"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30208]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/chatwoot"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/chatwoot/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/chatwoot/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "chatwoot": {
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "secret_key_base": "$RANDOM_STRING(32)",
      "frontend_url": "http://$SERVER_LAN_IP:30208"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/chatwoot/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/chatwoot/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30208}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
