{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS photoview 1.2.31"
  },
  "requirements": {
    "locations": [
      "ApplicationsCapacity",
      "ApplicationsPerformance",
      "Media"
    ],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30231]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsCapacity)"},
    {"path": "$LOCATION(ApplicationsCapacity)/photoview"},
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/photoview"},
    {"path": "$LOCATION(Media)", "network_share": true},
    {
      "path": "$LOCATION(ApplicationsCapacity)/photoview/media_cache",
      "owner": {"user": "apps"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/photoview/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "photoview": {"db_password": "$RANDOM_STRING(16)"},
    "storage": {
      "media_cache": "$HOST_PATH($LOCATION(ApplicationsCapacity)/photoview/media_cache)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/photoview/postgres_data)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30231}
    },
    "resources": {
      "limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"},
      "gpus": "$GPU_CONFIG()"
    }
  }
}
