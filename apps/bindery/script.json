{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS bindery 1.0.1"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance",
      "Documents",
      "Downloads",
      "Media"
    ],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30623]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/bindery"},
    {"path": "$LOCATION(Documents)", "network_share": true},
    {"path": "$LOCATION(Downloads)", "network_share": true},
    {"path": "$LOCATION(Media)", "network_share": true},
    {
      "path": "$LOCATION(ApplicationsPerformance)/bindery/config",
      "owner": {"user": "apps"},
      "snapshot": {"id": "config"}
    }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/bindery/config)",
      "books": "$HOST_PATH($LOCATION(Documents))",
      "downloads": "$HOST_PATH($LOCATION(Downloads))",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30623}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
