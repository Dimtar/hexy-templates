{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS keibidrop 1.0.0"
  },
  "installation_questions": [
    {
      "question": "Peer code",
      "type": "text",
      "key": "peer_code",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [26431]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/keibidrop"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/keibidrop/config",
      "owner": {"user": "apps"},
      "snapshot": {"id": "config"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/keibidrop/shares",
      "owner": {"user": "apps"},
      "snapshot": {"id": "shares"}
    }
  ],
  "app_values": {
    "keibidrop": {"peer_code": "$QUESTION(peer_code)"},
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/keibidrop/config)",
      "shares": "$HOST_PATH($LOCATION(ApplicationsPerformance)/keibidrop/shares)"
    },
    "network": {
      "inbound_port": {"bind_mode": "published", "port_number": 26431}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
