{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS jellystat 1.2.34"
  },
  "requirements": {
    "locations": [
      "ApplicationsCapacity",
      "ApplicationsPerformance",
      "Media"
    ],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30176]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsCapacity)"},
    {"path": "$LOCATION(ApplicationsCapacity)/jellystat"},
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/jellystat"},
    {"path": "$LOCATION(Media)", "network_share": true},
    {"path": "$LOCATION(ApplicationsCapacity)/jellystat/backup"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/jellystat/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "jellystat": {
      "db_password": "$RANDOM_STRING(16)",
      "jwt_secret": "$RANDOM_STRING(32)"
    },
    "storage": {
      "backup": "$HOST_PATH($LOCATION(ApplicationsCapacity)/jellystat/backup)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/jellystat/postgres_data)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30176}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
