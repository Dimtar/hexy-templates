{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS bookstack 1.2.26"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30214]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/bookstack"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/bookstack/uploads",
      "snapshot": {"id": "uploads"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/bookstack/storage_uploads",
      "snapshot": {"id": "storage_uploads"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/bookstack/mariadb_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "mariadb_data"}
    }
  ],
  "app_values": {
    "bookstack": {
      "db_password": "$RANDOM_STRING(16)",
      "db_root_password": "$RANDOM_STRING(16)",
      "app_url": "http://$SERVER_LAN_IP:30214",
      "app_key": "$RANDOM_STRING(32)"
    },
    "storage": {
      "uploads": "$HOST_PATH($LOCATION(ApplicationsPerformance)/bookstack/uploads)",
      "storage_uploads": "$HOST_PATH($LOCATION(ApplicationsPerformance)/bookstack/storage_uploads)",
      "mariadb_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/bookstack/mariadb_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30214}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
