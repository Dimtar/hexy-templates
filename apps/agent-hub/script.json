{
  "version": 5,
  "script": {
    "version": "0.1.1",
    "changeLog": "Regenerated for TrueNAS agent-hub 1.0.4"
  },
  "installation_questions": [
    {
      "question": "Viewer password",
      "type": "password",
      "key": "viewer_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30571, 30572]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/agent-hub"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/agent-hub/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    }
  ],
  "app_values": {
    "agent_hub": {"viewer_password": "$QUESTION(viewer_password)"},
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/agent-hub/data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30571},
      "ingest_port": {"bind_mode": "published", "port_number": 30572}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
