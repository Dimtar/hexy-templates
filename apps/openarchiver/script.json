{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS openarchiver 1.2.69"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30288]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/openarchiver"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/openarchiver/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/openarchiver/meili_data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "meili_data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/openarchiver/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "openarchiver": {
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "meilisearch_master_key": "$RANDOM_STRING(32)",
      "encryption_key": "$RANDOM_STRING(32)",
      "jwt_secret": "$RANDOM_STRING(32)",
      "app_url": "http://$SERVER_LAN_IP:30288"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/openarchiver/data)",
      "meili_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/openarchiver/meili_data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/openarchiver/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30288}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
