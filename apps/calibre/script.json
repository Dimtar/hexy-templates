      "http_port": {"bind_mode": "published", "port_number": 32015},
      "https_port": {"bind_mode": "published", "port_number": 32016}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
