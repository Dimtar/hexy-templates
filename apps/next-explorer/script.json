{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS next-explorer 1.1.14"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30045]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/next-explorer"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/next-explorer/config",
      "snapshot": {"id": "config"}
    }
  ],
  "app_values": {
    "next_explorer": {
      "public_url": "http://$SERVER_LAN_IP:30045",
      "session_secret": "$RANDOM_STRING(32)"
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/next-explorer/config)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30045}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
