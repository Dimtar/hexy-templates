{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS cashpilot 1.0.1"
  },
  "installation_questions": [
    {
      "question": "Api key",
      "type": "password",
      "key": "api_key",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30544]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/cashpilot"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/cashpilot/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/cashpilot/worker_data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "worker_data"}
    }
  ],
  "app_values": {
    "cashpilot": {"api_key": "$QUESTION(api_key)"},
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/cashpilot/data)",
      "worker_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/cashpilot/worker_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30544}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
