{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS kryspal-media 1.0.1"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "Media"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30564, 30565]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/kryspal-media"},
    {"path": "$LOCATION(Media)", "network_share": true},
    {
      "path": "$LOCATION(ApplicationsPerformance)/kryspal-media/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/kryspal-media/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "kryspal": {"db_password": "$RANDOM_STRING(16)"},
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/kryspal-media/data)",
      "media": "$HOST_PATH($LOCATION(Media))",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/kryspal-media/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30564},
      "wan_port": {"bind_mode": "published", "port_number": 30565}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
