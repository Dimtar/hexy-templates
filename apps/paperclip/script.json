{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS paperclip 1.0.4"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30534]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/paperclip"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/paperclip/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/paperclip/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "paperclip": {
      "db_password": "$RANDOM_STRING(16)",
      "better_auth_secret": "$RANDOM_STRING(32)",
      "tool_action_signing_secret": "$RANDOM_STRING(32)",
      "public_url": "http://$SERVER_LAN_IP:30534"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/paperclip/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/paperclip/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30534}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
