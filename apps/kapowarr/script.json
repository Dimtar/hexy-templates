    {
      "path": "$LOCATION(ApplicationsPerformance)/kapowarr/config",
      "snapshot": {"id": "config"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/kapowarr/content",
      "snapshot": {"id": "content"}
    }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/kapowarr/config)",
      "downloads": "$HOST_PATH($LOCATION(Downloads))",
      "content": "$HOST_PATH($LOCATION(ApplicationsPerformance)/kapowarr/content)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30093}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
