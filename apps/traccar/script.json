{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS traccar 1.2.42"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30206]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/traccar"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/traccar/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/traccar/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "traccar": {"db_password": "$RANDOM_STRING(16)"},
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/traccar/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/traccar/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30206}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
