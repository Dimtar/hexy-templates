{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS outline 1.2.48"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30144]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/outline"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/outline/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/outline/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "outline": {
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "secret_key": "$RANDOM_STRING(32)",
      "utils_secret": "$RANDOM_STRING(32)",
      "app_url": "http://$SERVER_LAN_IP:30144"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/outline/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/outline/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30144}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
