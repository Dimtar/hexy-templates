{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS lyrion-music-server 1.1.8"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "Music", "Media"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [31101, 31102, 3483]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/lyrion-music-server"},
    {"path": "$LOCATION(Music)", "network_share": true},
    {"path": "$LOCATION(Media)", "network_share": true},
    {
      "path": "$LOCATION(ApplicationsPerformance)/lyrion-music-server/config",
      "snapshot": {"id": "config"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/lyrion-music-server/playlist",
      "snapshot": {"id": "playlist"}
    }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/lyrion-music-server/config)",
      "music": "$HOST_PATH($LOCATION(Music))",
      "playlist": "$HOST_PATH($LOCATION(ApplicationsPerformance)/lyrion-music-server/playlist)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 31101},
      "cli_port": {"bind_mode": "published", "port_number": 31102},
      "discovery_port": {"bind_mode": "published", "port_number": 3483}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
