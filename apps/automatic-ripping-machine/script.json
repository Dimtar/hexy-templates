      "snapshot": {"id": "config"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/automatic-ripping-machine/home",
      "snapshot": {"id": "home"}
    },
    {
      "path": "$LOCATION(ApplicationsCapacity)/automatic-ripping-machine/logs"
    }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/automatic-ripping-machine/config)",
