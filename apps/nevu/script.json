      "path": "$LOCATION(ApplicationsPerformance)/nevu/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    }
  ],
  "app_values": {
    "nevu": {"plex_server": "$QUESTION(plex_server)"},
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/nevu/data)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30267},
      "discovery_port": {"bind_mode": "published", "port_number": 44201}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
