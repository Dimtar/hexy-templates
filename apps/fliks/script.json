{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS fliks 1.1.10"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "Media"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30485]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/fliks"},
    {"path": "$LOCATION(Media)", "network_share": true},
    {
      "path": "$LOCATION(ApplicationsPerformance)/fliks/config",
      "owner": {"user": "apps"},
      "snapshot": {"id": "config"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/fliks/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/fliks/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "fliks": {"db_password": "$RANDOM_STRING(16)"},
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/fliks/config)",
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/fliks/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/fliks/postgres_data)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30485}
    },
    "resources": {
      "limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"},
      "gpus": "$GPU_CONFIG()"
    }
  }
}
