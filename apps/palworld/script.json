{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS palworld 1.3.8"
  },
  "installation_questions": [
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [38211, 38212, 30443]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/palworld"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/palworld/steamcmd",
      "snapshot": {"id": "steamcmd"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/palworld/server",
      "snapshot": {"id": "server"}
    }
  ],
  "app_values": {
    "palworld": {"admin_password": "$QUESTION(admin_password)"},
    "storage": {
      "steamcmd": "$HOST_PATH($LOCATION(ApplicationsPerformance)/palworld/steamcmd)",
      "server": "$HOST_PATH($LOCATION(ApplicationsPerformance)/palworld/server)"
    },
    "network": {
      "server_port": {"bind_mode": "published", "port_number": 38211},
      "rcon_port": {"bind_mode": "published", "port_number": 38212},
      "api_port": {"bind_mode": "published", "port_number": 30443}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
