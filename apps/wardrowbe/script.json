{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS wardrowbe 1.0.0"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30613]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/wardrowbe"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/wardrowbe/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/wardrowbe/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "wardrowbe": {
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "secret_key": "$RANDOM_STRING(32)",
      "nextauth_secret": "$RANDOM_STRING(32)",
      "app_url": "http://$SERVER_LAN_IP:30613"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/wardrowbe/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/wardrowbe/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30613}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
