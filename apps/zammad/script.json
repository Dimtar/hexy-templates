{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS zammad 1.2.69"
  },
  "installation_questions": [
    {
      "question": "Elastic password",
      "type": "password",
      "key": "elastic_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30338]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/zammad"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/zammad/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/zammad/es_data",
      "snapshot": {"id": "es_data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/zammad/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "zammad": {
      "db_password": "$RANDOM_STRING(16)",
      "elastic_password": "$QUESTION(elastic_password)",
      "redis_password": "$RANDOM_STRING(16)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/zammad/data)",
      "es_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/zammad/es_data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/zammad/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30338}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
