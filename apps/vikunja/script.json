{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS vikunja 2.0.69"
  },
  "installation_questions": [
    {"question": "Url", "type": "text", "key": "url", "required": true}
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30107]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/vikunja"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/vikunja/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/vikunja/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "vikunja": {
      "url": "$QUESTION(url)",
      "jwt_secret": "$RANDOM_STRING(32)",
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/vikunja/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/vikunja/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30107}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
