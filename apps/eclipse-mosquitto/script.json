      "path": "$LOCATION(ApplicationsPerformance)/eclipse-mosquitto/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/eclipse-mosquitto/config",
      "owner": {"user": "apps"},
      "snapshot": {"id": "config"}
    }
  ],
  "app_values": {
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/eclipse-mosquitto/data)",
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/eclipse-mosquitto/config)"
    },
    "network": {
      "broker_port": {"bind_mode": "published", "port_number": 1883},
      "ws_port": {"bind_mode": "published", "port_number": 8081}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
