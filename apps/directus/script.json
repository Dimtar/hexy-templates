{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS directus 1.2.48"
  },
  "installation_questions": [
    {
      "question": "Admin email",
      "type": "text",
      "key": "admin_email",
      "required": true
    },
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30174]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/directus"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/directus/extensions",
      "snapshot": {"id": "extensions"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/directus/uploads",
      "snapshot": {"id": "uploads"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/directus/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "directus": {
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "secret": "$RANDOM_STRING(32)",
      "admin_email": "$QUESTION(admin_email)",
      "admin_password": "$QUESTION(admin_password)"
    },
    "storage": {
      "extensions": "$HOST_PATH($LOCATION(ApplicationsPerformance)/directus/extensions)",
      "uploads": "$HOST_PATH($LOCATION(ApplicationsPerformance)/directus/uploads)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/directus/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30174}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
