{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS filex 1.0.1"
  },
  "installation_questions": [
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30588]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/filex"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/filex/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/filex/files",
      "owner": {"user": "apps"},
      "snapshot": {"id": "files"}
    }
  ],
  "app_values": {
    "filex": {
      "admin_password": "$QUESTION(admin_password)",
      "secret_key": "$RANDOM_STRING(32)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/filex/data)",
      "files": "$HOST_PATH($LOCATION(ApplicationsPerformance)/filex/files)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30588}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
