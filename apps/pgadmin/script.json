{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS pgadmin 1.3.13"
  },
  "installation_questions": [
    {
      "question": "Admin email",
      "type": "text",
      "key": "admin_email",
      "required": true
    },
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30056]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/pgadmin"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/pgadmin/config",
      "snapshot": {"id": "config"}
    }
  ],
  "app_values": {
    "pgadmin": {
      "admin_email": "$QUESTION(admin_email)",
      "admin_password": "$QUESTION(admin_password)"
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/pgadmin/config)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30056}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
