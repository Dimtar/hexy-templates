{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS plex-auto-languages 1.4.16"
  },
  "installation_questions": [
    {
      "question": "Plex url",
      "type": "text",
      "key": "plex_url",
      "required": true
    },
    {
      "question": "Plex token",
      "type": "password",
      "key": "plex_token",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance", "Media"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/plex-auto-languages"},
    {"path": "$LOCATION(Media)", "network_share": true},
    {
      "path": "$LOCATION(ApplicationsPerformance)/plex-auto-languages/config",
      "owner": {"user": "apps"},
      "snapshot": {"id": "config"}
    }
  ],
  "app_values": {
    "plex_auto_languages": {
      "plex_url": "$QUESTION(plex_url)",
      "plex_token": "$QUESTION(plex_token)"
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/plex-auto-languages/config)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
