{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS forgejo 1.2.45"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30142, 30143]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/forgejo"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/forgejo/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/forgejo/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "forgejo": {
      "db_password": "$RANDOM_STRING(16)",
      "root_url": "http://$SERVER_LAN_IP:30142"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/forgejo/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/forgejo/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30142},
      "ssh_port": {"bind_mode": "published", "port_number": 30143}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
