{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS miniflux 1.2.37"
  },
  "installation_questions": [
    {
      "question": "Admin username",
      "type": "text",
      "key": "admin_username",
      "required": true
    },
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30285]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/miniflux"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/miniflux/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "miniflux": {
      "db_password": "$RANDOM_STRING(16)",
      "admin_username": "$QUESTION(admin_username)",
      "admin_password": "$QUESTION(admin_password)"
    },
    "storage": {
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/miniflux/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30285}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
