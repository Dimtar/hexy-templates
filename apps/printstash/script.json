{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS printstash 1.0.0"
  },
  "installation_questions": [
    {
      "question": "Admin username",
      "type": "text",
      "key": "admin_username",
      "required": true
    },
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30574]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/printstash"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/printstash/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    }
  ],
  "app_values": {
    "printstash": {
      "admin_username": "$QUESTION(admin_username)",
      "admin_password": "$QUESTION(admin_password)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/printstash/data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30574}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
