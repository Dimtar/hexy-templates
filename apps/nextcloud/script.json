{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS nextcloud 2.3.75"
  },
  "installation_questions": [
    {
      "question": "Admin user",
      "type": "text",
      "key": "admin_user",
      "required": true
    },
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30027]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/nextcloud"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/nextcloud/html",
      "snapshot": {"id": "html"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/nextcloud/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/nextcloud/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "nextcloud": {
      "admin_user": "$QUESTION(admin_user)",
      "admin_password": "$QUESTION(admin_password)",
      "redis_password": "$RANDOM_STRING(16)",
      "db_password": "$RANDOM_STRING(16)"
    },
    "storage": {
      "html": "$HOST_PATH($LOCATION(ApplicationsPerformance)/nextcloud/html)",
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/nextcloud/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/nextcloud/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30027}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
