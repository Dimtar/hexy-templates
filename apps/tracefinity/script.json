    {
      "path": "$LOCATION(ApplicationsPerformance)/tracefinity/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    }
  ],
  "app_values": {
    "tracefinity": {"auto_naming": "$QUESTION(auto_naming)"},
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/tracefinity/data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30479}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
