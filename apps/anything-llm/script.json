{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS anything-llm 1.1.19"
  },
  "installation_questions": [
    {
      "question": "Sig key",
      "type": "password",
      "key": "sig_key",
      "required": true
    },
    {
      "question": "Sig salt",
      "type": "password",
      "key": "sig_salt",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30239]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/anything-llm"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/anything-llm/data",
      "snapshot": {"id": "data"}
    }
  ],
  "app_values": {
    "anything_llm": {
      "sig_key": "$QUESTION(sig_key)",
      "sig_salt": "$QUESTION(sig_salt)",
      "jwt_secret": "$RANDOM_STRING(32)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/anything-llm/data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30239}
    },
    "resources": {
      "limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"},
      "gpus": "$GPU_CONFIG()"
    }
  }
}
