{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS ablago 1.0.0"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "ApplicationsCapacity"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30607]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/ablago"},
    {"path": "$LOCATION(ApplicationsCapacity)"},
    {"path": "$LOCATION(ApplicationsCapacity)/ablago"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/ablago/files",
      "snapshot": {"id": "files"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/ablago/key_store",
      "snapshot": {"id": "key_store"}
    },
    {"path": "$LOCATION(ApplicationsCapacity)/ablago/backups"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/ablago/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "ablago": {"db_password": "$RANDOM_STRING(16)"},
    "storage": {
      "files": "$HOST_PATH($LOCATION(ApplicationsPerformance)/ablago/files)",
      "key_store": "$HOST_PATH($LOCATION(ApplicationsPerformance)/ablago/key_store)",
      "backups": "$HOST_PATH($LOCATION(ApplicationsCapacity)/ablago/backups)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/ablago/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30607}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
