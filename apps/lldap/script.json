{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS lldap 1.1.8"
  },
  "installation_questions": [
    {
      "question": "Admin username",
      "type": "text",
      "key": "admin_username",
      "required": true
    },
    {
      "question": "Admin email",
      "type": "text",
      "key": "admin_email",
      "required": true
    },
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    },
    {
      "question": "Key seed",
      "type": "password",
      "key": "key_seed",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30325, 30326]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/lldap"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/lldap/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    }
  ],
  "app_values": {
    "lldap": {
      "admin_username": "$QUESTION(admin_username)",
      "admin_email": "$QUESTION(admin_email)",
      "admin_password": "$QUESTION(admin_password)",
      "jwt_secret": "$RANDOM_STRING(32)",
      "key_seed": "$QUESTION(key_seed)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/lldap/data)"
    },
    "network": {
      "http_port": {"bind_mode": "published", "port_number": 30325},
      "ldap_port": {"bind_mode": "published", "port_number": 30326}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
