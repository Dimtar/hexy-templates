{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS seaweedfs 1.2.39"
  },
  "installation_questions": [
    {
      "question": "Admin user",
      "type": "text",
      "key": "admin_user",
      "required": true
    },
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30300, 30301, 30302, 30303, 30304]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/seaweedfs"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/seaweedfs/admin_data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "admin_data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/seaweedfs/worker_data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "worker_data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/seaweedfs/master_data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "master_data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/seaweedfs/filer_data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "filer_data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/seaweedfs/volume_data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "volume_data"}
    }
  ],
  "app_values": {
    "seaweedfs": {
      "admin_user": "$QUESTION(admin_user)",
      "admin_password": "$QUESTION(admin_password)"
    },
    "storage": {
      "admin_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/seaweedfs/admin_data)",
      "worker_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/seaweedfs/worker_data)",
      "master_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/seaweedfs/master_data)",
      "filer_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/seaweedfs/filer_data)",
      "volume_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/seaweedfs/volume_data)"
    },
    "network": {
      "admin_port": {"bind_mode": "published", "port_number": 30300},
      "master_port": {"bind_mode": "published", "port_number": 30301},
      "volume_port": {"bind_mode": "published", "port_number": 30302},
      "filer_port": {"bind_mode": "published", "port_number": 30303},
      "s3_port": {"bind_mode": "published", "port_number": 30304}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
