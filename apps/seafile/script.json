{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS seafile 1.0.13"
  },
  "installation_questions": [
    {
      "question": "Admin email",
      "type": "text",
      "key": "admin_email",
      "required": true
    },
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30447]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/seafile"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/seafile/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/seafile/seadoc_data",
      "snapshot": {"id": "seadoc_data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/seafile/mariadb_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "mariadb_data"}
    }
  ],
  "app_values": {
    "seafile": {
      "db_password": "$RANDOM_STRING(16)",
      "db_root_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "server_url": "http://$SERVER_LAN_IP:30447",
      "admin_email": "$QUESTION(admin_email)",
      "admin_password": "$QUESTION(admin_password)",
      "jwt_private_key": "$RANDOM_STRING(32)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/seafile/data)",
      "seadoc_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/seafile/seadoc_data)",
      "mariadb_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/seafile/mariadb_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30447}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
