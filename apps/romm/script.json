{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS romm 1.2.46"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30061]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/romm"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/romm/library",
      "snapshot": {"id": "library"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/romm/resources",
      "snapshot": {"id": "resources"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/romm/config",
      "snapshot": {"id": "config"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/romm/assets",
      "snapshot": {"id": "assets"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/romm/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "romm": {
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "auth_secret_key": "$RANDOM_STRING(32)"
    },
    "storage": {
      "library": "$HOST_PATH($LOCATION(ApplicationsPerformance)/romm/library)",
      "resources": "$HOST_PATH($LOCATION(ApplicationsPerformance)/romm/resources)",
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/romm/config)",
      "assets": "$HOST_PATH($LOCATION(ApplicationsPerformance)/romm/assets)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/romm/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30061}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
