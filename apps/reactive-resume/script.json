{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS reactive-resume 1.0.53"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30393]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/reactive-resume"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/reactive-resume/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/reactive-resume/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "reactive_resume": {
      "db_password": "$RANDOM_STRING(16)",
      "secret_key": "$RANDOM_STRING(32)",
      "base_url": "http://$SERVER_LAN_IP:30393"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/reactive-resume/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/reactive-resume/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30393}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
