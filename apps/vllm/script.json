{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS vllm 1.0.18"
  },
  "installation_questions": [
    {
      "question": "Model name",
      "type": "text",
      "key": "model_name",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30422]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/vllm"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/vllm/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    }
  ],
  "app_values": {
    "vllm": {"model_name": "$QUESTION(model_name)"},
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/vllm/data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30422}
    },
    "resources": {
      "limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"},
      "gpus": "$GPU_CONFIG()"
    }
  }
}
