{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS silo 1.0.0"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "Media"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30539, 30541, 30540]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/silo"},
    {"path": "$LOCATION(Media)", "network_share": true},
    {
      "path": "$LOCATION(ApplicationsPerformance)/silo/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/silo/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/silo/meili_data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "meili_data"}
    }
  ],
  "app_values": {
    "silo": {
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "secret_key": "$RANDOM_STRING(32)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/silo/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/silo/postgres_data)",
      "meili_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/silo/meili_data)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30539},
      "jellyfin_compat_port": {
        "bind_mode": "published",
        "port_number": 30541
      },
      "audiobookshelf_compat_port": {
        "bind_mode": "published",
        "port_number": 30540
      }
    },
    "resources": {
      "limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"},
      "gpus": "$GPU_CONFIG()"
    }
  }
}
