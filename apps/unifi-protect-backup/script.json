{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS unifi-protect-backup 1.3.9"
  },
  "installation_questions": [
    {
      "question": "Username",
      "type": "text",
      "key": "username",
      "required": true
    },
    {
      "question": "Password",
      "type": "password",
      "key": "password",
      "required": true
    },
    {
      "question": "Address",
      "type": "text",
      "key": "address",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"]
  },
