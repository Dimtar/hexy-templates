{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS lumenaureum 1.0.2"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "Photos"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30589]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/lumenaureum"},
    {"path": "$LOCATION(Photos)", "network_share": true},
    {
      "path": "$LOCATION(ApplicationsPerformance)/lumenaureum/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/lumenaureum/vault",
      "owner": {"user": "apps"},
      "snapshot": {"id": "vault"}
    }
  ],
  "app_values": {
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/lumenaureum/data)",
      "vault": "$HOST_PATH($LOCATION(ApplicationsPerformance)/lumenaureum/vault)",
      "photos": "$HOST_PATH($LOCATION(Photos))"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30589}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
