{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS donetick 1.1.12"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30353]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/donetick"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/donetick/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/donetick/config",
      "owner": {"user": "apps"},
      "snapshot": {"id": "config"}
    }
  ],
  "app_values": {
    "donetick": {"jwt_secret": "$RANDOM_STRING(32)"},
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/donetick/data)",
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/donetick/config)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30353}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
