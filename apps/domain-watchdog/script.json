{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS domain-watchdog 1.2.35"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30317]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/domain-watchdog"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/domain-watchdog/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/domain-watchdog/config",
      "snapshot": {"id": "config"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/domain-watchdog/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "domain_watchdog": {
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "app_secret": "$RANDOM_STRING(32)",
      "jwt_passphrase": "$RANDOM_STRING(32)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/domain-watchdog/data)",
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/domain-watchdog/config)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/domain-watchdog/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30317}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
