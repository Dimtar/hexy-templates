{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS sparkyfitness 1.0.23"
  },
  "requirements": {
    "locations": ["ApplicationsCapacity", "ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30448]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsCapacity)"},
    {"path": "$LOCATION(ApplicationsCapacity)/sparkyfitness"},
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/sparkyfitness"},
    {
      "path": "$LOCATION(ApplicationsCapacity)/sparkyfitness/backup",
      "owner": {"user": "apps"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/sparkyfitness/uploads",
      "owner": {"user": "apps"},
      "snapshot": {"id": "uploads"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/sparkyfitness/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "sparkyfitness": {
      "db_password": "$RANDOM_STRING(16)",
      "api_encryption_key": "$RANDOM_STRING(32)",
      "better_auth_secret": "$RANDOM_STRING(32)",
      "frontend_url": "http://$SERVER_LAN_IP:30448"
    },
    "storage": {
      "backup": "$HOST_PATH($LOCATION(ApplicationsCapacity)/sparkyfitness/backup)",
      "uploads": "$HOST_PATH($LOCATION(ApplicationsPerformance)/sparkyfitness/uploads)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/sparkyfitness/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30448}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
