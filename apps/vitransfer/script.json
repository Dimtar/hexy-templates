{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS vitransfer 1.2.62"
  },
  "installation_questions": [
    {
      "question": "Share token secret",
      "type": "password",
      "key": "share_token_secret",
      "required": true
    },
    {
      "question": "Admin email",
      "type": "password",
      "key": "admin_email",
      "required": true
    },
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30291]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/vitransfer"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/vitransfer/redis_data",
      "snapshot": {"id": "redis_data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/vitransfer/uploads",
      "snapshot": {"id": "uploads"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/vitransfer/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "vitransfer": {
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "jwt_secret": "$RANDOM_STRING(32)",
      "jwt_refresh_secret": "$RANDOM_STRING(32)",
      "encryption_key": "$RANDOM_STRING(32)",
      "share_token_secret": "$QUESTION(share_token_secret)",
      "admin_email": "$QUESTION(admin_email)",
      "admin_password": "$QUESTION(admin_password)",
      "app_url": "http://$SERVER_LAN_IP:30291"
    },
    "storage": {
      "redis_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/vitransfer/redis_data)",
      "uploads": "$HOST_PATH($LOCATION(ApplicationsPerformance)/vitransfer/uploads)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/vitransfer/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30291}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
