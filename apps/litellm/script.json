{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS litellm 1.0.10"
  },
  "installation_questions": [
    {
      "question": "Salt key",
      "type": "password",
      "key": "salt_key",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30528]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/litellm"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/litellm/config",
      "owner": {"user": "apps"},
      "snapshot": {"id": "config"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/litellm/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "litellm": {
      "db_password": "$RANDOM_STRING(16)",
      "master_key": "$RANDOM_STRING(32)",
      "salt_key": "$QUESTION(salt_key)"
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/litellm/config)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/litellm/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30528}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
