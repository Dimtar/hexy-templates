{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS firefly-iii 1.9.65"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30105]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/firefly-iii"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/firefly-iii/uploads",
      "snapshot": {"id": "uploads"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/firefly-iii/postgres_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "postgres_data"}
    }
  ],
  "app_values": {
    "firefly_iii": {
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "app_key": "$RANDOM_STRING(32)"
    },
    "storage": {
      "uploads": "$HOST_PATH($LOCATION(ApplicationsPerformance)/firefly-iii/uploads)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/firefly-iii/postgres_data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30105}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
