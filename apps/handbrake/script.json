{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS handbrake 2.3.16"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "Media"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30089, 30044]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/handbrake"},
    {"path": "$LOCATION(Media)", "network_share": true},
    {
      "path": "$LOCATION(ApplicationsPerformance)/handbrake/config",
      "snapshot": {"id": "config"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/handbrake/output",
      "snapshot": {"id": "output"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/handbrake/storage",
      "snapshot": {"id": "storage"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/handbrake/watch",
      "snapshot": {"id": "watch"}
    }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/handbrake/config)",
      "output": "$HOST_PATH($LOCATION(ApplicationsPerformance)/handbrake/output)",
      "storage": "$HOST_PATH($LOCATION(ApplicationsPerformance)/handbrake/storage)",
      "watch": "$HOST_PATH($LOCATION(ApplicationsPerformance)/handbrake/watch)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30089},
      "vnc_port": {"bind_mode": "published", "port_number": 30044}
    },
    "resources": {
      "limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"},
      "gpus": "$GPU_CONFIG()"
    }
  }
}
