{
  "version": 5,
  "script": {
    "version": "0.1.1",
    "changeLog": "Regenerated for TrueNAS anilink-downloader 1.1.0"
  },
  "installation_questions": [
    {
      "question": "Debrid api key",
      "type": "password",
      "key": "debrid_api_key",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["Downloads", "Media"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30549, 30575]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(Downloads)", "network_share": true},
    {"path": "$LOCATION(Media)", "network_share": true}
  ],
  "app_values": {
    "anilink": {"debrid_api_key": "$QUESTION(debrid_api_key)"},
    "storage": {
      "downloads": "$HOST_PATH($LOCATION(Downloads))",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30549},
      "https_port": {"bind_mode": "published", "port_number": 30575}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
