{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS libredb-studio 1.0.15"
  },
  "installation_questions": [
    {
      "question": "Admin email",
      "type": "text",
      "key": "admin_email",
      "required": true
    },
    {
      "question": "Admin password",
      "type": "password",
      "key": "admin_password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30469]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/libredb-studio"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/libredb-studio/data",
      "owner": {"user": "apps"},
      "snapshot": {"id": "data"}
    }
  ],
  "app_values": {
    "libredb": {
      "admin_email": "$QUESTION(admin_email)",
      "admin_password": "$QUESTION(admin_password)",
      "jwt_secret": "$RANDOM_STRING(32)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/libredb-studio/data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30469}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
