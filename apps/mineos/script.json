{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS mineos 1.3.7"
  },
  "installation_questions": [
    {
      "question": "Username",
      "type": "text",
      "key": "username",
      "required": true
    },
    {
      "question": "Password",
      "type": "password",
      "key": "password",
      "required": true
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30052]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/mineos"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/mineos/data",
      "snapshot": {"id": "data"}
    }
  ],
  "app_values": {
    "mineos": {
      "username": "$QUESTION(username)",
      "password": "$QUESTION(password)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/mineos/data)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30052}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
