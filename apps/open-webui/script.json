{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS open-webui 1.3.28"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [31028]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/open-webui"},
    {
      "path": "$LOCATION(ApplicationsPerformance)/open-webui/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/open-webui/ollama",
      "snapshot": {"id": "ollama"}
    }
  ],
  "app_values": {
    "open_webui": {
      "redis_password": "$RANDOM_STRING(16)",
      "webui_secret_key": "$RANDOM_STRING(32)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/open-webui/data)",
      "ollama": "$HOST_PATH($LOCATION(ApplicationsPerformance)/open-webui/ollama)"
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 31028}
    },
    "resources": {
      "limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"},
      "gpus": "$GPU_CONFIG()"
    }
  }
}
