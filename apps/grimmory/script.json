{
  "version": 5,
  "script": {
    "version": "0.1.0",
    "changeLog": "Auto-generated draft from TrueNAS grimmory 1.0.22"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "Documents", "Media"],
    "specifications": ["2CORE"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30396]
  },
  "ensure_directories_exists": [
    {"path": "$LOCATION(ApplicationsPerformance)"},
    {"path": "$LOCATION(ApplicationsPerformance)/grimmory"},
    {"path": "$LOCATION(Documents)", "network_share": true},
    {"path": "$LOCATION(Media)", "network_share": true},
    {
      "path": "$LOCATION(ApplicationsPerformance)/grimmory/data",
      "snapshot": {"id": "data"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/grimmory/bookdrop",
      "snapshot": {"id": "bookdrop"}
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/grimmory/mariadb_data",
      "owner": {"user": "netdata", "group": "docker"},
      "snapshot": {"id": "mariadb_data"}
    }
  ],
  "app_values": {
    "grimmory": {
      "db_password": "$RANDOM_STRING(16)",
      "db_root_password": "$RANDOM_STRING(16)"
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/grimmory/data)",
      "books": "$HOST_PATH($LOCATION(Documents))",
      "bookdrop": "$HOST_PATH($LOCATION(ApplicationsPerformance)/grimmory/bookdrop)",
      "mariadb_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/grimmory/mariadb_data)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)"
      ]
    },
    "network": {
      "web_port": {"bind_mode": "published", "port_number": 30396}
    },
    "resources": {"limits": {"cpus": 2, "memory": "$MEMORY(10%, 4096)"}}
  }
}
